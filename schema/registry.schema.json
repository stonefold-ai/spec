{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stonefold.ai/schema/v0.1/registry.schema.json",
  "title": "Registry (Domain Model) v0.1",
  "description": "Schema for a registry/domain-model document. Semantics in docs/06-registry-domain-model.md. Structural checks only; cross-reference checks are performed by the linter.",
  "type": "object",
  "required": ["domain", "entities"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "type": "string" },
    "domain": { "type": "string", "minLength": 1 },
    "connectors": {
      "type": "object",
      "additionalProperties": { "type": "object", "properties": { "type": { "type": "string" }, "digest": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" } }, "additionalProperties": true }
    },
    "scopePredicates": { "type": "array", "items": { "type": "string" } },
    "preconditionChecks": { "type": "array", "items": { "$ref": "#/$defs/preconditionCheck" } },
    "sources": {
      "type": "object",
      "description": "Things a control reads that may age or become unreachable (docs/06 §5e): a rule set, a record in another system, or a fact the deployment maintains. A gate names one of these in its `reads:`.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["ruleSet", "record", "fact"] },
          "label": { "type": "string" },
          "derivedFrom": { "type": "array", "items": { "type": "string" }, "description": "For a `fact`: the actions it is maintained from. A fact derived from an action the gateway does not see is a fact it cannot maintain." }
        }
      }
    },
    "handlers": { "type": "array", "items": { "type": "string" } },
    "hooks": { "type": "array", "items": { "type": "string" } },
    "sinks": { "type": "array", "items": { "type": "string" } },
    "namedSets": {
      "type": "object",
      "additionalProperties": { "type": "object", "properties": { "source": { "type": "string" }, "values": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": true }
    },
    "valueSets": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
    "obligationRegistries": {
      "description": "systems of record the requireMatch gate matches against. Semantics in docs/06 section 5b.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/obligationRegistry" }
    },
    "entities": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/entity" } }
  },
  "$defs": {
    "preconditionCheck": {
      "description": "a bare name (two-valued check, codes default terminal) or an object declaring hold capability and reason codes with retry classes. holdCapable without reasonCodes is a linter error (Stele rule 18), not a schema error.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "holdCapable": { "type": "boolean" },
            "reasonCodes": {
              "type": "object",
              "additionalProperties": { "enum": ["retryable", "terminal", "escalate"] }
            }
          }
        }
      ]
    },
    "obligationRegistry": {
      "type": "object",
      "required": ["connector", "capability", "schema"],
      "additionalProperties": false,
      "properties": {
        "connector": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
        "capability": { "enum": ["transactional", "window"] },
        "schema": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/obligationProperty" } }
      }
    },
    "obligationProperty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "values": { "type": "array", "items": { "type": "string" } },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/obligationProperty" } }
      },
      "anyOf": [ { "required": ["type"] }, { "required": ["values"] }, { "required": ["properties"] } ]
    },
    "attrValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "object", "required": ["derived"], "additionalProperties": false, "properties": { "derived": { "type": "string" } } }
      ]
    },
    "entity": {
      "type": "object",
      "required": ["properties"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "dataSource": { "type": "string" },
        "table": { "type": "string" },
        "collection": { "type": "string" },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/property" } },
        "actions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/action" } }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "values": { "type": "array", "items": { "type": "string" } },
        "required": { "type": "boolean" },
        "derived": { "type": "string" },
        "label": { "type": "string" }
      },
      "anyOf": [ { "required": ["type"] }, { "required": ["values"] } ]
    },
    "action": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["observe", "assess", "record", "effect", "transition"] },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reversibility": { "$ref": "#/$defs/attrValue" },
            "emission": { "$ref": "#/$defs/attrValue" },
            "operativeForce": { "$ref": "#/$defs/attrValue" },
            "resultSensitivity": { "$ref": "#/$defs/attrValue" },
            "explainability": { "$ref": "#/$defs/attrValue" }
          }
        },
        "data": { "type": "object", "additionalProperties": { "$ref": "#/$defs/property" } },
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field"],
          "description": "This action carries a list of items in one field (docs/06 §5d) — read by Stele §12's per-item decision semantics.",
          "properties": {
            "field": { "type": "string", "description": "The data field carrying the items; MUST be a declared `data` field of this action." },
            "independent": { "type": "boolean", "description": "Applying a SUBSET of the items is meaningful. A safety property: false for any set the managed system treats as one transaction. Default false." },
            "maxItems": { "type": "integer", "minimum": 1, "description": "Refuse a call carrying more than this outright, rather than evaluating it quietly." },
            "key": { "type": "string", "description": "Where items are objects, the field that names one, so a refusal can identify it." }
          }
        },
        "closure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dispositionField"],
          "description": "What closing this action means (docs/06 §5c) — read by the standard `dispositionIsDeclared` check (Stele §7.6).",
          "properties": {
            "dispositionField": { "type": "string", "description": "The data field carrying the disposition; MUST be declared in this action's `data`, and its `values` are the declared vocabulary." },
            "claimsCompletion": { "type": "array", "items": { "type": "string" }, "description": "The dispositions that assert the work was DONE. A subset of the field's declared values; SHOULD be a strict subset, so an honest non-completion disposition exists." }
          }
        },
        "resolve": { "type": "object", "additionalProperties": { "type": "object", "required": ["entity"], "additionalProperties": true, "properties": { "entity": { "type": "string" } } } },
        "compensation": {
          "description": "Declared in-system undo action (Stele spec section 13 rule 10). Required when reversibility is 'compensable'; the linter checks the target exists.",
          "type": "object",
          "required": ["resource", "action"],
          "additionalProperties": false,
          "properties": {
            "resource": { "type": "string" },
            "action": { "type": "string" }
          }
        },
        "connector": { "type": "string" },
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "postActions": { "type": "array", "items": { "type": "string" } },
        "from": { "type": "array", "items": { "type": "string" } },
        "to": { "type": "string" },
        "label": { "type": "string" }
      }
    }
  }
}
